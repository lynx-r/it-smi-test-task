NODE_ENV=

# ! Server Config
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=3000

# ! Swagger Doc url pattern
SWAGGER_DOCS_PATH=docs
SWAGGER_PATH=api_docs

# ! CORS — comma-separated origins, or * for all
CORS_ORIGINS=*

# ! Rate limiting for auth endpoints (logIn, register, refreshToken)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=10

# ! JWT config section
JWT_SECRET=
jwtAccessExpire=10000
jwtRefreshExpire=10000

# ! Database config section
DATABASE_CONNECTION_URL=postgres://DATABASE_USERNAME:DATABASE_PASSWORD@DATABASE_HOST:DATABASE_PORT/DATABASE_NAME
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_PORT=
DATABASE_HOST=

# ! Active profile default data 
# Имя
ACTIVE_PROFILE_NAME=Aleksei
# Краткое описание
ACTIVE_PROFILE_DESCRIPTION=TypeScript-разработчик (backend)
# Ссылки на GitHub/LinkedIn или другие профессиональные ресурсы 
# (Название Ресурса;Ссылка на ресурс;Название Ресурса;Ссылка на ресурс;...)
ACTIVE_PROFILE_LINKS=GitHub;https://github.com/lynx-r;StackOverflow;https://stackoverflow.com/users/836701/alex-po
# Список навыков
ACTIVE_PROFILE_SKILLS=JavaScript;TypeScript;Vue.js;Frontend;Vuex;API;REST API;Nuxt.js;Pinia;SPA;Docker;SSR;Веб-программирование;Git;Node.js;PostgreSQL;MySQL;Swagger;Prisma;TypeORM;GitHub;SourceCraft;Yandex Cloud
# Опыт работы (Компания;Должность;Начало работы [например, 2026-03-01];Окончание [например, 2026-06-01];Достижения;Компания;Должность;Начало работы [например, 2026-03-01];Окончание [например, 2026-06-01];Достижения;...)
ACTIVE_PROFILE_EXPERIENCE=Фриланс;Fullstack-разработчик;2026-03-01;2026-06-01;Разработал MVP интернет-магазина;Фриланс;Fullstack-разработчик;2026-02-01;2026-03-01;Разработал MVP CRM-системы
# Проекты (Название;Ссылка на проект/репозиторий;Название;Ссылка на проект/репозиторий;...)
